{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",//增量构建缓存信息文件的存储路径
    "target": "ES2022",//编译后 JS 的目标版本
    "lib": ["ES2023"],//指定 TypeScript 编译时包含的标准库声明文件
    "module": "ESNext",//使用 ES Module 模块系统
    "skipLibCheck": true,//跳过node_modules中三方库的类型检查，跳过项目中.d.ts 文件的类型检查

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, //允许导入 .ts 结尾的模块
    "verbatimModuleSyntax": true, //保留原样输出
    "moduleDetection": "force", //强制所有 .ts 文件都被当作模块处理
    "noEmit": true, //不生成 .js 文件，通常用于只做类型检查。

    /* Linting */
    "strict": true,
    "noUnusedLocals": true, //禁止未使用的局部变量
    "noUnusedParameters": true, //禁止未使用的函数参数
    "erasableSyntaxOnly": true, //只允许可擦除的语法
    "noFallthroughCasesInSwitch": true, //switch 语句中必须显式 break
    "noUncheckedSideEffectImports": true //禁止未检查的副作用导入
  },
  "include": ["vite.config.ts"]  //此配置文件只用于 vite.config.ts
}
